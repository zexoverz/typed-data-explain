{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "endcredits start"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Grep|Glob|Write|Edit|MultiEdit|WebFetch|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "endcredits record"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "endcredits settle",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
